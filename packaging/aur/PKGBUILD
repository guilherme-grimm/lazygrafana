# Maintainer: The lazygrafana Authors
# Binary package built from the GitHub release tarball.
# Update pkgver and the checksums (from the release's .sha256 files) on each release.
pkgname=lazygrafana-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="A lazygit-style terminal UI for operating Grafana"
arch=('x86_64' 'aarch64')
url="https://github.com/guilherme-grimm/lazygrafana"
license=('MIT' 'Apache-2.0')
provides=('lazygrafana')
conflicts=('lazygrafana')
optdepends=('libsecret: keyring token storage (secret-tool)')
source_x86_64=("$url/releases/download/v$pkgver/lazygrafana-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/lazygrafana-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "lazygrafana-v$pkgver-$CARCH-unknown-linux-gnu"
  install -Dm755 lazygrafana "$pkgdir/usr/bin/lazygrafana"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
